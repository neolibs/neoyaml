{
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "type": "module",
  "scripts": {
    "lint": "oxlint",
    "format": "oxfmt",
    "test": "bun run --parallel --filter='./packages/**' test",
    "test:bun": "bun run --parallel --filter='./packages/**' test:bun",
    "build": "bun run --parallel --filter='./packages/**' build"
  },
  "devDependencies": {
    "@gameroman/config": "0.2.6",
    "@types/node": "26.1.2",
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0",
    "oxlint-tsgolint": "0.25.0",
    "typescript": "7.0.2"
  }
}
